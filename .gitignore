# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.local-verification/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/.staging-verification/
/.playwright-mcp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI runtime state (contains generated local API credentials)
/supabase/.temp/
/supabase/.branches/
/supabase/.env*
/supabase/signing_keys.json

# Private credentials, browser sessions, dumps and restore artifacts
**/identities.json
**/credential-manifest*.json
**/credentials*.json
**/auth-state*.json
**/storage-state*.json
**/storageState*.json
**/cookies*.json
**/session*.json
*.dump
*.backup
*.bak
*.sqlite
*.sqlite3
**/*dump*.sql
**/*restore*.sql
/restore-artifacts/
/backups/
/browser-evidence/
/screenshots/
/test-results/
/playwright-report/
*.log
/clinic-scaffold/
