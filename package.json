{
  "name": "jo-lin-care",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "dev:local-test": "node --env-file=.env.test.local scripts/run-local-app.mjs dev",
    "start:local-test": "node --env-file=.env.test.local scripts/run-local-app.mjs start",
    "test:integration": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run src/test/integration.test.ts",
    "bootstrap:staging": "node --env-file=.env.staging.local scripts/bootstrap-staging.mjs",
    "test:staging": "node scripts/run-staging-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
