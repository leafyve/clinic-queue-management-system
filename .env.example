# Safe reference only. Copy into an ignored file; never commit secret values.
# Explicitly choose LOCAL, STAGING or PRODUCTION; NODE_ENV does not select data.
APP_ENV=LOCAL
NEXT_PUBLIC_APP_ENV=LOCAL
NEXT_PUBLIC_LOCAL_PREVIEW=false
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Cloud: replace URL/keys with the dedicated project's values and matching ref.
STAGING_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
# openssl rand -base64 32
MEDICAL_DATA_ENCRYPTION_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
# STAGING only: explicit developer-controlled recipients, digits, comma separated.
STAGING_WHATSAPP_RECIPIENTS=
